# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Facebook Graph API configuration
# Meta Page ID (Must be set via environment variable / secrets)
FACEBOOK_PAGE_ID=""
# Meta Page Access Token (Server-side secret only)
FACEBOOK_PAGE_ACCESS_TOKEN=""
# Safety Switch: Must explicitly be set to "true" to enable real Facebook posting.
# Default is false to prevent accidental publication.
FACEBOOK_PUBLISHING_ENABLED="false"

# LINE Messaging API configuration (Store in AI Studio Secrets)
# LINE Channel Access Token for push notifications and webhook replies
LINE_CHANNEL_ACCESS_TOKEN=""
# LINE Channel Secret for HMAC-SHA256 webhook signature verification
LINE_CHANNEL_SECRET=""
# Target LINE User ID (Optional fallback; discovered automatically from signed webhook "test" message)
LINE_TARGET_ID=""

# Google Drive Integration (Primary workflow prefers administrator OAuth)
GOOGLE_DRIVE_FOLDER_ID=""

# Optional Creative Providers (DALL-E)
OPENAI_API_KEY=""
